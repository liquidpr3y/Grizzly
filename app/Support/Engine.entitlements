<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the bundled engine's executables (python3,
  ffmpeg). The Grizzly app itself needs none.
  - allow-jit / allow-unsigned-executable-memory: ctypes callbacks and the
    LLVM JIT that numba (pulled in by the ML libraries) uses write code at run time.
  - disable-library-validation: Python loads hundreds of extension modules;
    they are signed with our identity, but a wheel that ships a library
    signed by its own vendor would otherwise fail to load.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
